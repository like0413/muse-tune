{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "muse-tune",
  "version": "0.1.0",
  "identifier": "com.like.muse-tune",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1480",
    "beforeDevCommand": "vp dev",
    "beforeBuildCommand": "vp build"
  },
  "app": {
    "windows": [
      {
        "label": "taskbar",
        "title": "Muse Tune",
        "url": "index.html#/taskbar",
        "width": 360,
        "height": 48,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "focusable": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Muse Tune 设置",
        "url": "index.html#/settings",
        "width": 960,
        "height": 680,
        "minWidth": 640,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "devCsp": {
        "default-src": "'self' http://localhost:1480",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1480 ws://localhost:1480",
        "font-src": "'self' data: http://localhost:1480",
        "img-src": "'self' data: blob: http://localhost:1480",
        "style-src": "'self' 'unsafe-inline' http://localhost:1480",
        "script-src": "'self' http://localhost:1480",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "shortDescription": "Windows 11 taskbar media controller",
    "longDescription": "Muse Tune shows and controls the current Windows media session from the Windows 11 taskbar.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDNzZFQkQ1MEFFMkZDNDMKUldSRC9PSUsxZXQyZkFGY3hhMGdoMXhhbmxlbU45aDd3UUtVbjYyZlRIUC9EaUY4M3lhL29rYm0K",
      "endpoints": ["https://github.com/like0413/muse-tune/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
