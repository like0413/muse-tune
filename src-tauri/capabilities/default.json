{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Muse Tune taskbar and settings windows",
  "platforms": ["windows"],
  "windows": ["taskbar", "taskbar-*", "settings", "volume-popup"],
  "permissions": [
    "core:default",
    "store:default",
    "log:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/like0413/muse-tune*" }]
    },
    "updater:default",
    "autostart:default",
    "fs:default",
    "dialog:allow-open",
    "dialog:allow-confirm"
  ]
}
