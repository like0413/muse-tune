{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Muse Tune taskbar and settings windows",
  "platforms": ["windows"],
  "windows": ["taskbar", "taskbar-*", "settings"],
  "permissions": [
    "core:default",
    "store:default",
    "log:default",
    "updater:default",
    "autostart:default",
    "fs:default"
  ]
}
